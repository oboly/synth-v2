[Unit]
Description=Synth Market Rotation Pressure writer timer (gurkDB-bound candidate artifact)
Documentation=https://github.com/oboly/synth-v2/blob/main/docs/ops/market_rotation_pressure_runtime_owners_v1.md
Requires=synth-market-rotation-pressure-writer.service

[Timer]
# Runs on deterministic native 15-minute boundaries after the canonical
# obs_market_candle source. The candle-freshness writer starts at
# :02,:17,:32,:47 UTC and has observed full-universe completion in ~4-7
# minutes. Starting at :12,:27,:42,:57 retains at least a three-minute
# margin after that completion window without inventing 5-minute snapshots.
OnCalendar=*-*-* *:12,27,42,57:00 UTC
Persistent=true
RandomizedDelaySec=0
Unit=synth-market-rotation-pressure-writer.service

[Install]
WantedBy=timers.target
