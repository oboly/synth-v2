[Unit]
Description=Synth Market Rotation Pressure writer timer — fires after hourly source-data availability (UTC)
Documentation=docs/ops/market_rotation_pressure_runtime_owners_v1.md
Requires=synth-market-rotation-pressure-writer.service

[Timer]
# Runs at minute :20 of every hour, UTC. Evidence (see
# docs/ops/market_rotation_pressure_runtime_owners_v1.md): the Odroid
# synth-market-candle-freshness user timer ingests 1h obs_market_candle rows
# on a ~15m30s cadence and observed journal history shows the run started
# immediately after each hour boundary (e.g. HH:04:52) finishes persisting by
# ~HH:11:28. Minute :20 gives a safety margin beyond that observed
# completion lag before the writer reads the hourly rotation-history source.
OnCalendar=*-*-* *:20:00 UTC
Persistent=true
RandomizedDelaySec=180
Unit=synth-market-rotation-pressure-writer.service

[Install]
WantedBy=timers.target
