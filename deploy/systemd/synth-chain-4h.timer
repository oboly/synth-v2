[Unit]
Description=Synth 4h market-only chain timer — fires 12 min after each 4h candle close (UTC)
Documentation=https://github.com/oboly/synth-v2/blob/main/docs/deployment/synth_market_only_runtime_v1.md
Requires=synth-chain-4h.service

[Timer]
# The devlap candle writer runs first; this chain validates persisted 4h data read-only.
OnCalendar=*-*-* 00,04,08,12,16,20:12:00 UTC
Persistent=true
RandomizedDelaySec=120
Unit=synth-chain-4h.service

[Install]
WantedBy=timers.target
