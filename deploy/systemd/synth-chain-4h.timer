[Unit]
Description=Synth 4h market-only chain timer — fires 8 min after each 4h candle close (UTC)
Documentation=https://github.com/oboly/synth-v2/blob/main/docs/deployment/synth_market_only_runtime_v1.md
Requires=synth-chain-4h.service

[Timer]
# 8 minutes after each 4h candle close: 00:08, 04:08, 08:08, 12:08, 16:08, 20:08 UTC
OnCalendar=*-*-* 00,04,08,12,16,20:08:00 UTC
Persistent=true
RandomizedDelaySec=120
Unit=synth-chain-4h.service

[Install]
WantedBy=timers.target
