[Unit]
Description=Synth automatic-exit policy runtime timer (capability AUTOMATIC_EXIT_POLICY_RUNTIME)
Documentation=https://github.com/oboly/synth-v2/blob/main/docs/architecture/automatic_exit_policy_v1.md

[Timer]
OnCalendar=*-*-* *:0/5:00 UTC
Persistent=true
RandomizedDelaySec=15
Unit=synth-automatic-exit-policy-runtime.service

[Install]
WantedBy=timers.target
