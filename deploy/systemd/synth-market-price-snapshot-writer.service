[Unit]
Description=Synth public market-price snapshot writer (devlap sole owner)
Documentation=https://github.com/oboly/synth-v2/blob/main/docs/ops/public_market_data_runtime_owners_v1.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gurk
WorkingDirectory=/home/gurk/projects/synth-v2
Environment=SYNTH_LIVE_EXECUTION_PERMISSION=NOT_GRANTED
Environment=SYNTH_BROKER_WRITE_PERMISSION=NOT_GRANTED
ExecStart=/bin/bash -lc 'bash scripts/run_market_price_snapshot_once.sh'
Restart=no
Nice=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synth-market-price-snapshot-writer

[Install]
WantedBy=multi-user.target
