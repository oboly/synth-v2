[Unit]
Description=Synth public market-price snapshot writer (gurkDB canonical owner)
Documentation=https://github.com/oboly/synth-v2/blob/main/docs/ops/writer_capability_host_ownership_contract_v1.md
ConditionHost=gurkdb
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gurk
WorkingDirectory=/home/gurk/projects/synth-v2
Environment=SYNTH_LIVE_EXECUTION_PERMISSION=NOT_GRANTED
Environment=SYNTH_BROKER_WRITE_PERMISSION=NOT_GRANTED
Environment=SYNTH_WRITER_EXECUTION_MODE=PRODUCTION
ExecStartPre=/home/gurk/projects/synth-v2/.venv/bin/python -m src.operations.verify_writer_capability_authorization_v1 --capability public_price_snapshot --service synth-market-price-snapshot-writer.service --checkout-path /home/gurk/projects/synth-v2 --registry deploy/ownership/writer_capability_ownership_v1.json
ExecStart=/bin/bash -lc 'bash scripts/run_market_price_snapshot_once.sh'
Restart=no
Nice=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=false
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synth-market-price-snapshot-writer

[Install]
WantedBy=multi-user.target
