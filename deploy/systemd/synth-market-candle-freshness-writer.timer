[Unit]
Description=Synth multi-interval candle freshness writer timer (capability public-candle-freshness-writer)
Documentation=https://github.com/oboly/synth-v2/blob/main/docs/ops/writer_capability_host_ownership_contract_v1.md

[Timer]
OnCalendar=*-*-* *:02,17,32,47:00 UTC
Persistent=true
RandomizedDelaySec=30
Unit=synth-market-candle-freshness-writer.service

[Install]
WantedBy=timers.target
