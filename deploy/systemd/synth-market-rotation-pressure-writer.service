[Unit]
Description=Synth Market Rotation Pressure writer (devlap-bound historical/candidate artifact; capability market_rotation_pressure)
Documentation=https://github.com/oboly/synth-v2/blob/main/docs/ops/market_rotation_pressure_runtime_owners_v1.md
# This committed unit is host-bound to devlap paths/users. Rotation Pressure
# devlap acceptance is historical SUPERSEDED evidence, not current production
# authorization.
ConditionHost=devlap
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gurk
WorkingDirectory=/home/gurk/projects/synth-v2
Environment=SYNTH_LIVE_EXECUTION_PERMISSION=NOT_GRANTED
Environment=SYNTH_BROKER_WRITE_PERMISSION=NOT_GRANTED
ExecStartPre=/bin/bash -lc 'python -m src.operations.verify_writer_capability_authorization_v1 --capability market_rotation_pressure --service synth-market-rotation-pressure-writer.service --checkout-path /home/gurk/projects/synth-v2 --registry deploy/ownership/writer_capability_ownership_v1.json'
ExecStart=/bin/bash -lc 'source venv/bin/activate && bash scripts/run_market_rotation_pressure_once.sh --write-db'
Restart=no
Nice=5
UMask=0077
NoNewPrivileges=true
# PrivateTmp intentionally disabled: the wrapper's flock lock file
# (default /tmp/synth-market-rotation-pressure-v1.lock) must be visible in
# the host-wide /tmp namespace so a timer-triggered run and a manual
# invocation of the same wrapper serialize against the same lock file
# instead of silently running concurrently in separate private /tmp views.
PrivateTmp=false
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synth-market-rotation-pressure-writer

# Safety boundary:
# - writes only Rotation History and Rotation Pressure market-data state
#   through the existing writer wrapper (run_market_rotation_pressure_once.sh)
# - does not invoke reporting or dashboard publication
# - does not SSH or otherwise reach the Odroid publisher host
# - does not invoke Profit Plan
# - does not invoke selection_engine, decision_gate, execution_planner, or executor
# - no broker calls, no order submission

[Install]
WantedBy=multi-user.target
