[Unit]
Description=Synth public market-price snapshot writer timer (capability public-price-snapshot-writer)
Documentation=https://github.com/oboly/synth-v2/blob/main/docs/ops/writer_capability_host_ownership_contract_v1.md

[Timer]
OnCalendar=*-*-* *:00/5:00 UTC
Persistent=true
RandomizedDelaySec=30
Unit=synth-market-price-snapshot-writer.service

[Install]
WantedBy=timers.target
