[Unit]
Description=Synth 4h market-only chain
Documentation=https://github.com/oboly/synth-v2/blob/main/docs/deployment/synth_market_only_runtime_v1.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gurk
WorkingDirectory=/home/gurk/projects/synth-v2
ExecStart=/bin/bash -lc 'source venv/bin/activate && bash scripts/run_chain_4h.sh'
Restart=no
Nice=5

Environment=SYNTH_EXECUTION_MODE=paper
Environment=SYNTH_LIVE_EXECUTION_PERMISSION=NOT_GRANTED
Environment=SYNTH_BROKER_WRITE_PERMISSION=NOT_GRANTED
Environment=SYNTH_PAPER_ADVICE_DASHBOARD_REMOTE_HOST=odroid
Environment=SYNTH_PAPER_ADVICE_DASHBOARD_REMOTE_PATH=/var/www/html/synth/paper-advice.html

StandardOutput=journal
StandardError=journal
SyslogIdentifier=synth-chain-4h

[Install]
WantedBy=multi-user.target
