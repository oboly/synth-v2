[Unit]
Description=Synth 4h market-only chain (gurkdb-bound; capability native_short_4h_chain)
Documentation=https://github.com/oboly/synth-v2/blob/main/docs/deployment/synth_market_only_runtime_v1.md
# This committed unit is host-bound to gurkdb paths/users.
ConditionHost=gurkdb
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=gurk
Group=gurk
WorkingDirectory=/home/gurk/projects/synth-v2
ExecStart=/bin/bash /home/gurk/projects/synth-v2/scripts/run_chain_4h.sh
Restart=no
Nice=5
UMask=0077
NoNewPrivileges=true

# EnvironmentFile is intentionally absent. The closed DB profile below ignores
# generic checkout .env DB values and reads only the dedicated password file.
Environment=SYNTH_REPO_DIR=/home/gurk/projects/synth-v2
Environment=SYNTH_CHAIN_4H_LOCKED=0
Environment=SYNTH_CHAIN_4H_LOCK_FILE=/tmp/synth_chain_4h.lock
Environment=SYNTH_DB_BINDING_PROFILE=synth_chain_4h
Environment=SYNTH_CHAIN_4H_DB_HOST=gurkdb
Environment=SYNTH_CHAIN_4H_DB_PORT=3306
Environment=SYNTH_CHAIN_4H_DB_USER=synth_chain_4h_writer
Environment=SYNTH_CHAIN_4H_DB_NAME=synth
Environment=SYNTH_CHAIN_4H_DB_PASSWORD_FILE=/etc/synth/synth-chain-4h-db-password-v1
Environment=SYNTH_EXECUTION_MODE=paper
Environment=SYNTH_LIVE_EXECUTION_PERMISSION=NOT_GRANTED
Environment=SYNTH_BROKER_WRITE_PERMISSION=NOT_GRANTED
Environment=SYNTH_WRITER_EXECUTION_MODE=PRODUCTION
ExecStartPre=/home/gurk/projects/synth-v2/venv/bin/python -m src.operations.run_synth_chain_4h_db_environment_preflight_v1 --checkout-path /home/gurk/projects/synth-v2
ExecStartPre=/home/gurk/projects/synth-v2/venv/bin/python -m src.operations.run_synth_chain_4h_db_grant_preflight_v1
ExecStartPre=/home/gurk/projects/synth-v2/venv/bin/python -m src.operations.verify_writer_capability_authorization_v1 --capability native_short_4h_chain --service synth-chain-4h.service --checkout-path /home/gurk/projects/synth-v2 --registry deploy/ownership/writer_capability_ownership_v1.json
PrivateTmp=false

StandardOutput=journal
StandardError=journal
SyslogIdentifier=synth-chain-4h

[Install]
WantedBy=multi-user.target
