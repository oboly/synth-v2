{
  "contract_version": "v1",
  "purpose": "Machine-readable source of truth for public market-data writer-capability ownership. Separates acceptance_host from production_runtime_owner and stores a neutral, host-independent owner identity per capability. A successful acceptance run proves the software/runtime on a host; it does NOT by itself assign or canonize permanent production ownership.",
  "authoritative_doc": "docs/ops/writer_capability_host_ownership_contract_v1.md",
  "invariants": {
    "acceptance_host_is_not_production_owner": true,
    "exactly_one_production_owner_per_capability": true,
    "production_owner_requires_separate_decision_evidence": true,
    "acceptance_evidence_cannot_satisfy_production_decision": true,
    "historical_runtime_assignment_is_not_active_ownership": true,
    "owner_identity_is_host_independent": true,
    "consumers_reporting_account_runtimes_own_zero_writer_capabilities": true,
    "all_production_runtime_owners_unassigned_by_this_correction": true
  },
  "host_status": {
    "gurkdb": "UNVERIFIED",
    "devlap": "UNVERIFIED",
    "odroid": "UNVERIFIED"
  },
  "candidate_topology": {
    "note": "Preferred direction only, not a proven outcome. Each role requires separate, technically justified, operationally accepted evidence.",
    "gurkdb": ["light account-agnostic public-market-data writers", "possible acceptance host for those same writers"],
    "odroid": ["account runtimes", "persisted-state consumers", "dashboards and publication"],
    "devlap": ["development", "tests", "optional controlled acceptance", "no implicit permanent production ownership"]
  },
  "writer_capabilities": [
    {
      "capability_id": "public_price_snapshot",
      "kind": "public_market_data_writer",
      "owner_identity": "public-price-snapshot-writer",
      "owner_identity_env": "SYNTH_MARKET_PRICE_WRITER_OWNER",
      "wrapper": "scripts/run_market_price_snapshot_once.sh",
      "service": "deploy/systemd/synth-market-price-snapshot-writer.service",
      "timer": "deploy/systemd/synth-market-price-snapshot-writer.timer",
      "lock": "/tmp/synth-market-price-snapshot-writer-v1.lock",
      "cadence": "*-*-* *:00/5:00 UTC",
      "writes": ["market_price_snapshot"],
      "account_or_reporting_coupling": false,
      "evaluated_separately": false,
      "acceptance_host": "UNASSIGNED",
      "acceptance_status": "UNASSIGNED",
      "production_runtime_owner": "UNASSIGNED",
      "production_owner_status": "UNASSIGNED",
      "production_decision_evidence": "",
      "preferred_candidate_host": "gurkdb",
      "candidate_hosts": ["gurkdb", "odroid", "devlap"]
    },
    {
      "capability_id": "public_candle_freshness",
      "kind": "public_market_data_writer",
      "owner_identity": "public-candle-freshness-writer",
      "owner_identity_env": "SYNTH_MARKET_CANDLE_WRITER_OWNER",
      "wrapper": "scripts/run_market_candle_freshness_once.sh",
      "service": "deploy/systemd/synth-market-candle-freshness-writer.service",
      "timer": "deploy/systemd/synth-market-candle-freshness-writer.timer",
      "lock": "/tmp/synth-market-candle-freshness-writer-v1.lock",
      "cadence": "minutes 02,17,32,47 UTC",
      "writes": ["obs_market_candle"],
      "intervals": ["15m", "1h", "4h", "1d", "1w"],
      "account_or_reporting_coupling": false,
      "evaluated_separately": false,
      "acceptance_host": "UNASSIGNED",
      "acceptance_status": "UNASSIGNED",
      "production_runtime_owner": "UNASSIGNED",
      "production_owner_status": "UNASSIGNED",
      "production_decision_evidence": "",
      "preferred_candidate_host": "gurkdb",
      "candidate_hosts": ["gurkdb", "odroid", "devlap"]
    },
    {
      "capability_id": "market_rotation_pressure",
      "kind": "public_market_data_writer",
      "owner_identity": "market-rotation-pressure-writer",
      "owner_identity_env": "SYNTH_ROTATION_PRESSURE_WRITER_OWNER",
      "wrapper": "scripts/run_market_rotation_pressure_once.sh",
      "service": "deploy/systemd/synth-market-rotation-pressure-writer.service",
      "timer": "docs/ops/systemd (installed host-side) synth-market-rotation-pressure-writer.timer",
      "lock": "/tmp/synth-market-rotation-pressure-v1.lock",
      "cadence": "*:20:00 UTC",
      "writes": ["market_rotation_history", "market_rotation_pressure"],
      "account_or_reporting_coupling": false,
      "evaluated_separately": false,
      "acceptance_host": "devlap",
      "acceptance_status": "ACCEPTED",
      "production_runtime_owner": "UNASSIGNED",
      "production_owner_status": "UNASSIGNED",
      "production_decision_evidence": "",
      "historical_runtime_assignment": {
        "host": "devlap",
        "source": "PR #100 / PR #101",
        "status": "SUPERSEDED",
        "reason": "The devlap host assignment was derived from the accepted implementation/acceptance sequence without a separately confirmed infrastructure host-selection decision. Acceptance and current installed-host state are historical audit context, not continuing canonical production authorization.",
        "preserved_evidence": "Three real per-invocation-verified hourly writer->publisher cycles, idempotency/reconciliation audits, and installed active timer state remain recorded in docs/ops/market_rotation_pressure_runtime_owners_v1.md. These prove acceptance and installed-host state; they do NOT satisfy production_decision_evidence."
      },
      "preferred_candidate_host": "gurkdb",
      "candidate_hosts": ["gurkdb", "odroid", "devlap"]
    },
    {
      "capability_id": "native_short_4h_chain",
      "kind": "market_only_chain",
      "owner_identity": "native-short-4h-chain",
      "owner_identity_env": "SYNTH_NATIVE_SHORT_4H_CHAIN_OWNER",
      "wrapper": "scripts/run_chain_4h.sh",
      "service": "deploy/systemd/synth-chain-4h.service",
      "timer": "deploy/systemd/synth-chain-4h.timer",
      "lock": "/tmp/synth_chain_4h.lock",
      "cadence": "00,04,08,12,16,20:12:00 UTC",
      "writes": ["native_short_scope_status", "native_short_map_status", "native_short_fib_context_snapshot (published artifact)"],
      "account_or_reporting_coupling": false,
      "evaluated_separately": true,
      "evaluated_separately_reason": "The 4h chain carries CPU, repository-source-identity, publication, and artifact dependencies distinct from the light DB writers. It must NOT be auto-moved with the database writers; CPU, repository, publication, and artifact dependencies are assessed on their own.",
      "acceptance_host": "UNASSIGNED",
      "acceptance_status": "UNASSIGNED",
      "production_runtime_owner": "UNASSIGNED",
      "production_owner_status": "UNASSIGNED",
      "production_decision_evidence": "",
      "preferred_candidate_host": "UNASSIGNED",
      "candidate_hosts": ["gurkdb", "odroid", "devlap"]
    }
  ],
  "consumers_with_zero_writer_capabilities": [
    "scripts/odroid/run_linked_profile_runtime_orchestrator_once.sh",
    "scripts/odroid/run_mvp_dashboard_render_once.sh",
    "scripts/odroid/run_mvp_market_context_refresh_once.sh",
    "scripts/odroid/run_paper_advice_dashboard_refresh_once.sh",
    "scripts/odroid/run_market_rotation_pressure_dashboard_render_once.sh"
  ],
  "forbidden_writer_invocation_tokens": [
    "src.market_data.run_market_price_snapshot_v1",
    "src.etl.bitvavo.run_candles_etl",
    "scripts/run_market_price_snapshot_once.sh",
    "scripts/run_market_candle_freshness_once.sh",
    "scripts/run_chain_4h.sh",
    "scripts/run_native_short_scope_status_chain_once.sh",
    "src.market_data.run_native_short_scope_status_chain_v1",
    "src.market_data.run_native_short_map_materializer_v1",
    "scripts/run_market_rotation_pressure_once.sh",
    "src.research.run_market_rotation_history_v1",
    "src.research.run_market_rotation_pressure_v1"
  ]
}
