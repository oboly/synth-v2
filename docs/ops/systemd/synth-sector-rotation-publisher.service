[Unit]
Description=Synth Sector Overview publisher (Odroid candidate owner, read-only)
Documentation=docs/ops/sector_rotation_runtime_activation_v1.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=theone
WorkingDirectory=/home/theone/projects/synth-v2
ExecStart=/bin/bash -lc 'source venv/bin/activate && bash scripts/odroid/run_sector_rotation_dashboard_render_once.sh'
Restart=no
Nice=5
UMask=0077
NoNewPrivileges=true
# PrivateTmp intentionally disabled: the wrapper's flock lock file
# (default /tmp/synth-sector-rotation-dashboard-v1.lock) must be visible in
# the host-wide /tmp namespace so a timer-triggered run and a manual
# invocation of the same wrapper serialize against the same lock file
# instead of silently running concurrently in separate private /tmp views.
PrivateTmp=false
StandardOutput=journal
StandardError=journal
SyslogIdentifier=synth-sector-rotation-publisher

# read-only persisted sector_rotation_snapshot -> HTML/JSON publication
#
# Safety boundary:
# - no --write-db, no writer invocation
# - no market-data mutation
# - no broker/account calls
# - independent of the gurkDB writer timer: this unit does not declare
#   Requires=/After= on the writer and performs no remote/SSH orchestration;
#   a failed or delayed writer cycle does not fail this service. The
#   publisher's own fail-closed rules (DATA_UNAVAILABLE atomically replaces
#   any previously published output) govern what gets published when the
#   newest persisted cohort is missing, incomplete, or stale.

[Install]
WantedBy=multi-user.target
